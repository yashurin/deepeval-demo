# Copy this file to .env and change whatever you like.
# Docker Compose reads .env automatically for the ${...} substitutions
# in docker-compose.yml. The Python app also reads it when you run a
# script on the host.

# Ollama model tag. This model answers the questions. It is also the
# DeepEval judge unless JUDGE_MODEL is set. The first `docker compose up`
# downloads it into the ollama_models volume.
# qwen3.5:2b is about 3 GB. Larger tags (qwen3.5:4b, qwen3.5:9b) judge
# more steadily and need more RAM.
OLLAMA_MODEL=qwen3.5:2b

# Optional. When set, `python -m app.run_evals` also runs this model and
# prints a side-by-side score table. The judge stays OLLAMA_MODEL.
# phi4-mini is about 2.5 GB. Leave empty for a single-model run.
# COMPARE_MODEL=phi4-mini

# Optional scorer override. Empty means the judge is OLLAMA_MODEL.
# JUDGE_MODEL=

# Host port published by the Ollama container. Inside the app container
# the URL is always http://ollama:11434 (set by docker-compose.yml).
# If `docker compose up` says port 11434 is already in use, a local
# Ollama app owns that port. Set this to a free one, such as 11435.
OLLAMA_PORT=11434

# Host port for the Gradio page. Open http://localhost:7860.
# Browsers cannot open http://0.0.0.0. Change this if 7860 is taken.
UI_PORT=7860

# How long Ollama keeps the weights in memory between calls.
OLLAMA_KEEP_ALIVE=30m

# qwen3.5 thinks by default. Thinking text breaks the JSON DeepEval
# expects from a judge, and it makes a 2B model very slow. false sends
# Ollama's think=false flag. Use "omit" for a model that rejects it.
OLLAMA_THINK=false

# Sampling temperature for the support bot. The judge stays at 0.
APP_TEMPERATURE=0.2
JUDGE_TEMPERATURE=0

# Context window sent with every request. Higher values use more RAM.
NUM_CTX=8192

# Per-request HTTP timeout, in seconds, for the bot, the judge, and pulls.
OLLAMA_TIMEOUT=600

# Extra attempts after a dropped connection, an HTTP 5xx, an empty
# answer, or judge JSON that did not match the schema. 0 tries once.
OLLAMA_RETRIES=2

# Metric pass bars. Each score is between 0 and 1.
ANSWER_RELEVANCY_THRESHOLD=0.5
FAITHFULNESS_THRESHOLD=0.5
CORRECTNESS_THRESHOLD=0.5
HELPFULNESS_THRESHOLD=0.5
CONTEXTUAL_RELEVANCY_THRESHOLD=0.5

# Comma-separated: relevancy, faithfulness, correctness, helpfulness,
# contextual_relevancy.
# Faithfulness and contextual relevancy run only on the RAG cases.
METRICS=relevancy,faithfulness,correctness,helpfulness,contextual_relevancy

# One local model cannot serve a crowd of judge calls. Leave this false.
RUN_ASYNC=false

# Record a metric error and keep going, instead of aborting the run.
IGNORE_EVAL_ERRORS=true

# Where DeepEval writes the local JSON report. Mounted to ./results.
RESULTS_DIR=/app/results
